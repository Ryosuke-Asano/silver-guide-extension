{
  "manifest_version": 3,
  "name": "Silver Guide",
  "version": "3.0.0",
  "incognito": "split",
  "description": "入力欄のヒント、単語クリックの解説ポップアップ、文章のサイドパネル解説、PDFへの記入を端末内で支援します。",
  "action": {
    "default_title": "Silver Guide（文章の解説）",
    "default_icon": {
      "32": "icons/book-32.png",
      "16": "icons/book-16.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "sidePanel"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https: http:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src 'none'"
  },
  "icons": {
    "32": "icons/book-32.png",
    "64": "icons/book-64.png",
    "16": "icons/book-16.png",
    "128": "icons/book-128.png",
    "48": "icons/book-48.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_ui": {
    "page": "demo/setup.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "122"
}
