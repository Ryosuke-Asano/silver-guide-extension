{
  "manifest_version": 3,
  "name": "Silver Guide",
  "version": "0.1.0",
  "description": "すべてのページの理解を助け、行政ページでは入力と導線を支援します。",
  "action": {
    "default_title": "Silver Guide",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "silver-guide@example.invalid",
      "strict_min_version": "121.0"
    }
  }
}
