{
  "manifest_version": 3,
  "name": "Silver Guide",
  "version": "3.0.0",
  "icons": {
    "16": "icons/book-16.png",
    "32": "icons/book-32.png",
    "48": "icons/book-48.png",
    "64": "icons/book-64.png",
    "128": "icons/book-128.png"
  },
  "description": "入力欄のヒント、単語クリックの解説ポップアップ、文章のサイドパネル解説、PDFへの記入を端末内で支援します。",
  "action": {
    "default_title": "Silver Guide",
    "default_icon": {
      "32": "icons/book-32.png",
      "16": "icons/book-16.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "silver-guide@example.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https: http:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src 'none'"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "sidebar_action": {
    "default_title": "Silver Guide",
    "default_panel": "sidebar.html",
    "default_icon": {
      "32": "icons/book-32.png"
    }
  }
}
