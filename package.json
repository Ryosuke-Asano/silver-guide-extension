{
  "name": "silver-guide-extension",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm run assets:prepare && pnpm run check && node scripts/build-extension.mjs",
    "build:chromium": "pnpm run assets:prepare && pnpm run check && node scripts/build-extension.mjs --chromium",
    "assets:prepare": "node scripts/prepare-runtime-assets.mjs",
    "assets:download": "node scripts/prepare-runtime-assets.mjs --download",
    "check": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "demo": "node demo/server.mjs",
    "test": "vitest run --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "jsdom": "30.1.2",
    "playwright": "1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.7"
  }
}
